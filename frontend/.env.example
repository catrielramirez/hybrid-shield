# ==========================================================
# HYBRID SHIELD — FRONTEND ENVIRONMENT VARIABLES
# ==========================================================
# Next.js only auto-loads ".env.local" (and ".env") — copy the variables
# you need from here into one of those files, they are gitignored.
#   cp .env.example .env.local
#
# All NEXT_PUBLIC_* variables are inlined into the client bundle at build
# time: never put secrets in them. There are no server-only secrets in
# this frontend today (see BACKEND_SERVICE_URL note below).
#
# Every variable below was verified against actual `process.env.*` reads
# in the current codebase (app/page.tsx, app/hitl/page.tsx,
# app/actions/analyze.ts, lib/firebase.ts, next.config.ts).
# ==========================================================

# ---------------------------------------------------------
# Data source mode
# ---------------------------------------------------------

# "mock"   -> uses static/mocked data (lib/mock/*), makes zero GCP/backend
#             calls. See app/page.tsx, app/hitl/page.tsx, lib/firebase.ts.
# anything else (or unset) -> real backend/GCP mode.
# Equivalent shortcut: `npm run dev:mock` sets this for you.
NEXT_PUBLIC_DATA_SOURCE=mock

# ---------------------------------------------------------
# Backend connection (ignored while NEXT_PUBLIC_DATA_SOURCE=mock)
# ---------------------------------------------------------

# Base URL of the FastAPI backend (backend/main.py). Used directly by
# app/page.tsx, app/hitl/page.tsx, app/actions/analyze.ts, and as the
# rewrite target in next.config.ts. Defaults to http://127.0.0.1:8000
# in code if left unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# How image uploads are performed (app/page.tsx uploadToGCS):
#   "local"      -> multipart POST to {NEXT_PUBLIC_API_URL}/api/upload-direct
#   "signed_url" -> (default) GCS v4 signed URL flow via
#                   {NEXT_PUBLIC_API_URL}/api/get-upload-url
NEXT_PUBLIC_STORAGE_STRATEGY=signed_url

# Public app URL. Currently only used by scripts/CI-style metadata, not
# read anywhere in app/ or lib/ as of this writing — safe to leave as-is.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------------------------------------------------------
# Firebase (client SDK) — lib/firebase.ts
# ---------------------------------------------------------
# Required for real (non-mock) mode: lib/firebase.ts falls back to
# hard-coded "mock-*" placeholder values for any of these that are
# missing, which will silently fail against a real Firebase project.
# Get these values from Firebase Console > Project settings > General >
# "Your apps" > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ---------------------------------------------------------
# Present in some local env files but NOT read by any current code path
# ---------------------------------------------------------
# BACKEND_SERVICE_URL — found in a previous .env.local but no
# process.env.BACKEND_SERVICE_URL reference exists in app/ or lib/.
# Left out on purpose; add it back only if you wire it up to something.
