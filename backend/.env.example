# ==========================================================
# HYBRID SHIELD — BACKEND ENVIRONMENT VARIABLES
# ==========================================================
# Copy this file to ".env" (same folder) and fill in real values.
#   cp .env.example .env
#
# This file is read by:
#   - backend/main.py            (FastAPI app, via python-dotenv)
#   - backend/agents/moderator/** (LangGraph agent + services)
#   - backend/deploy/*.py         (Vertex AI Reasoning Engine deploy scripts)
#
# All variable reads are centralized in backend/config.py (plain functions,
# not a class/singleton — see the comment at the top of that file for why).
# Every default below mirrors what used to be hardcoded, so leaving a
# variable unset keeps existing behavior unchanged.
# ==========================================================

# ---------------------------------------------------------
# REQUIRED — Core GCP project
# ---------------------------------------------------------

# GCP project ID. Read via config.get_project_id() everywhere: main.py,
# ai_service.py, rag_service.py, graph.py, flywheel.py, deploy scripts.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region for Gemini + Reasoning Engine calls.
# Used by ai_service.py / rag_service.py. NOTE: this is unrelated to
# Cloud SQL's region below (Cloud SQL cannot use "global").
GOOGLE_CLOUD_LOCATION=us-central1


# ---------------------------------------------------------
# REQUIRED — Cloud SQL / LangGraph checkpointer (graph.py)
# ---------------------------------------------------------

# Format: "<PROJECT_ID>:<REGION>:<INSTANCE_ID>"
# config.parse_cloud_sql_connection() splits this string on ":" and is the
# SINGLE source of truth for the Cloud SQL instance identity — both
# graph.py's checkpointer and audit_service.py's history reader use it, so
# they always resolve to the same instance. (Previously audit_service.py
# read separate PROJECT_ID / GCP_REGION / DB_INSTANCE_NAME variables that
# could silently drift from this one — that duplication was removed.)
DB_CONNECTION_NAME=your-gcp-project-id:us-central1:your-instance-id

# Postgres database name inside the Cloud SQL instance (defaults to
# "agent_states" if omitted).
DB_NAME=agent_states

# Cloud SQL user/password. graph.py only attaches these to the connection
# if BOTH are present; otherwise it falls back to IAM DB auth.
# NEVER commit real values — this file only ships placeholders.
DB_USER=agent_admin
DB_PASS=changeme


# ---------------------------------------------------------
# REQUIRED — Vertex AI Search (RAG) — rag_service.py
# ---------------------------------------------------------

# Vertex AI Search Data Store ID that holds the moderation policy documents.
# If unset, rag_service.py skips RAG entirely (logs a warning, no crash).
DATA_STORE_ID=your-data-store-id

# Vertex AI Search Engine ID. Falls back to DATA_STORE_ID if unset.
ENGINE_ID=your-search-engine-id


# ---------------------------------------------------------
# GCS buckets — READ CAREFULLY, these are TWO DIFFERENT variables
# ---------------------------------------------------------

# Bucket used by main.py for the actual upload / moderation pipeline
# (get-upload-url, upload-direct, metadata endpoints). Defaults to
# "ecommerce-police-media-uploads" in code if left unset.
GCS_BUCKET_NAME=your-uploads-bucket-name

# Bucket used ONLY by the offline eval script
# (backend/tests/evals/moderator_balancer_evals.py) for the golden dataset.
# This is intentionally a separate variable from GCS_BUCKET_NAME above —
# do not assume they point to the same bucket.
GOOGLE_CLOUD_BUCKET=your-golden-dataset-bucket-name


# ---------------------------------------------------------
# Firestore (firestore_service.py)
# ---------------------------------------------------------
# Optional overrides — both used to be hardcoded literals. Defaults match
# those old literals exactly, so you can leave both commented out safely.

# Defaults to GOOGLE_CLOUD_PROJECT if unset.
# FIRESTORE_PROJECT_ID=your-gcp-project-id

# Named Firestore database (not the "(default)" database).
# FIRESTORE_DATABASE_ID=firestore-hybrid-shield


# ---------------------------------------------------------
# Vertex AI Reasoning Engine deploy scripts (backend/deploy/*.py)
# ---------------------------------------------------------

# Deploy region for the Agent Engine itself. Intentionally separate from
# GOOGLE_CLOUD_LOCATION (which may be "global" for Gemini/Search) — Agent
# Engine needs an actual region.
# REASONING_ENGINE_LOCATION=us-central1

# Numeric ID of an already-deployed Reasoning Engine. Required by
# re_deploy_reasoning_engine.py, delete_reasoning_instance.py and
# test_reasoning_engine.py — NOT by the first deploy_reasoning_engine.py run,
# which prints this ID for you to paste in here afterwards.
# REASONING_ENGINE_ID=your-reasoning-engine-numeric-id


# ---------------------------------------------------------
# Local development behavior
# ---------------------------------------------------------

# When true, main.py / firestore_service.py use impersonated credentials
# (via SERVICE_ACCOUNT_EMAIL) instead of the native Cloud Run service
# account. Required locally to generate GCS v4 signed URLs, since a user's
# Application Default Credentials normally cannot sign URLs on their own.
# Leave unset ("false"/absent) in production (Cloud Run).
LOCAL_DEV=true

# Service account to impersonate locally for signed URL generation
# (main.py get-upload-url endpoint). Must have "Service Account Token
# Creator" on itself and the storage roles needed to sign + write.
SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Marks the environment for test-specific branches in async_utils.py.
# Leave unset outside of automated tests.
# APP_ENV=test


# ---------------------------------------------------------
# CORS — main.py
# ---------------------------------------------------------

# Comma-separated list of allowed origins, e.g. "https://your-frontend.app".
# "*" disables credentials automatically (see main.py CORS setup) since
# FastAPI forbids combining allow_origins=["*"] with allow_credentials=True.
ALLOWED_ORIGINS=*


# ---------------------------------------------------------
# Local-only path helpers (used by ad-hoc scripts, not the API/agent)
# ---------------------------------------------------------
# These are absolute paths on the developer's machine. They are NOT
# portable — set them to your own local paths, or omit them if you don't
# use the scripts that reference them.
# NEXTJS_PUBLIC_DIR=/absolute/path/to/frontend/public
# LOCAL_DATASET_DIR=/absolute/path/to/data
